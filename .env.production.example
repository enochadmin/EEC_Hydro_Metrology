# EEC-BHDMS — production environment
# Copy to .env on the server, fill every value, then run `php artisan key:generate`
# only if APP_KEY is empty. Never commit the real file.

APP_NAME="EEC-BHDMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=https://bhdms.example.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eec_bhdms
DB_USERNAME=eec_bhdms
DB_PASSWORD=

# Backups (php artisan eec:backup, scheduled daily)
BACKUP_ENABLED=true
BACKUP_TIME=01:30
BACKUP_RETENTION_DAYS=30
DB_DUMP_BINARY=/usr/bin/mysqldump

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Store uploaded workbooks and documents on the private disk.
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@bhdms.example.org"
MAIL_FROM_NAME="${APP_NAME}"

# Basemaps: Terrain, Satellite and Streets need no key. CARTO styles require a
# key from https://carto.com/basemaps/apikey/ and a successful `php artisan gis:basemap-key`.
CARTO_BASEMAPS_KEY=
GIS_DEFAULT_BASEMAP=terrain

# Optional: restrict which hosts may present cookies (comma separated).
SANCTUM_STATEFUL_DOMAINS=bhdms.example.org
